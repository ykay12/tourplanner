        </mxCell>
        <mxCell id="BhPnE26yl6zxW_kvSACi-37" edge="1" parent="1" source="BhPnE26yl6zxW_kvSACi-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.998;entryY=0.05;entryDx=0;entryDy=0;entryPerimeter=0;" target="A-X-2ZvYbxmhMmvuhy7v-180">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2120" y="4041" />
              <mxPoint x="2120" y="5187" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="BhPnE26yl6zxW_kvSACi-38" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px; color: rgb(76, 0, 153);&quot;&gt;Design Decision:&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Since creating tours is the core functionality we want to make it very easy for the user to do that,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;which is why we have this big button on the landing page as well as the option to reach this functionality from every page through the main menu&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="190" x="-10" y="4370" as="geometry" />
        </mxCell>
        <mxCell id="BhPnE26yl6zxW_kvSACi-39" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px; color: rgb(76, 0, 153);&quot;&gt;Design Decision:&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Since Estimated Time and Total Distance are retrieved from&amp;nbsp;OpenRouteservice.org&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;We had the following options:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;1.) only show them, once the tour is created (only 1 API-Request)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;2.) show them everytime the user adds a step&amp;nbsp; or changes From and To (More User friendly but a lot of API-Requests)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;3.) Have them only retrieved by a user action&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;We decided to add the &quot;calculate&quot;-Button, so that the user can see these values before creating the tour but to reduce the number of API Requests&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="350" width="290" x="1000" y="5950" as="geometry" />
        </mxCell>
        <mxCell id="BhPnE26yl6zxW_kvSACi-48" edge="1" parent="1" source="BhPnE26yl6zxW_kvSACi-41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=1;entryDx=0;entryDy=0;" target="BhPnE26yl6zxW_kvSACi-44">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2085" y="7260" />
              <mxPoint x="1760" y="7260" />
              <mxPoint x="1760" y="7179" />
            </Array>
          </mxGeometry>
        </mxCell>
