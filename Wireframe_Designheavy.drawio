        <mxCell id="K5whRTNLt02dNtwVT43Y-62" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Hier würde ich so ziemlich &quot;add new tour&quot; übernehmen und nur die Felder schon vorausfüllen" vertex="1">
