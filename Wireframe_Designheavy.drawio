        <mxCell id="BhPnE26yl6zxW_kvSACi-376" parent="BhPnE26yl6zxW_kvSACi-224" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Toure&lt;/font&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;n&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="1239" y="284.5" as="geometry" />
        </mxCell>
        <mxCell id="BhPnE26yl6zxW_kvSACi-365" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;color: rgb(76, 0, 153); font-size: 15px;&quot;&gt;Design Decision: Buttons&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;On the Phone I want the Buttons to be easy to reach, which is why they are all placed to the right&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;On the Desktop however the buttons are placed where we would look for them&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="250" x="5210" y="1630" as="geometry" />
        </mxCell>
        <mxCell id="BhPnE26yl6zxW_kvSACi-369" edge="1" parent="1" source="BhPnE26yl6zxW_kvSACi-366" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;" target="BhPnE26yl6zxW_kvSACi-176">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BhPnE26yl6zxW_kvSACi-366" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;color: rgb(76, 0, 153); font-size: 15px;&quot;&gt;Design Decision: Tour Type / Pictogramm vs written&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;Since on the desktop I can hoover over the Pictogramm next to the Tour Name it can be shown that it indicates that the type of tour is vacation.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;On Mobile, since I can not hoover we also added a written Information&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="360" x="5190" y="1910" as="geometry" />
        </mxCell>
        <mxCell id="BhPnE26yl6zxW_kvSACi-370" edge="1" parent="1" source="BhPnE26yl6zxW_kvSACi-365" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.202;entryDx=0;entryDy=0;entryPerimeter=0;exitX=-0.019;exitY=0.545;exitDx=0;exitDy=0;exitPerimeter=0;" target="BhPnE26yl6zxW_kvSACi-158">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BhPnE26yl6zxW_kvSACi-373" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;color: rgb(76, 0, 153); font-size: 15px;&quot;&gt;Design Decision: Layout&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;In Order to be able to have a nice size on the indivuduall sections they are placed on top of each other on the mobile version&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;Where as on the desktop version we can make use of the wohle width&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="360" x="5170" y="2200" as="geometry" />
        </mxCell>
        <mxCell id="BhPnE26yl6zxW_kvSACi-377" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;color: rgb(76, 0, 153); font-size: 15px;&quot;&gt;Design Decision: Scrolling&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;On Mobile a scrollable section is very annoying to navigate, which is why instead we display all elements of the sections steps and Tour Logs,&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;but make them collapseable for easyier use&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="360" x="5178.88" y="2750" as="geometry" />
        </mxCell>
        <mxCell id="BhPnE26yl6zxW_kvSACi-380" parent="1" style="shape=rect;strokeColor=none;fillColor=light-dark(#314f63, #229afd);strokeWidth=1;dashed=0;rounded=1;arcSize=20;fontColor=#ffffff;fontSize=17;spacing=2;spacingTop=-2;align=left;autosize=1;spacingLeft=4;resizeWidth=0;resizeHeight=0;perimeter=none;html=1;whiteSpace=wrap;shadow=1;" value="" vertex="1">
